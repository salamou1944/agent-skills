    "knowledgeOnly": [
      "Astra-",
      "Files-"
    ],
    "capabilitySources": [
      "Project-/COLLECTION source repos",
      "Top Five source repos",
      "aw-junaid",
      "mufeedvh",
      "Panniantong",
      "nmap ecosystem",
      "Agent Reach families",
      "mnfst/awesome-free-llm-apis"
    ],
    "promotion": [
